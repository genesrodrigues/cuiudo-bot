# Copie este arquivo para .env e preencha com suas credenciais

# Token do bot Discord (obtenha em https://discord.com/developers/applications)
DISCORD_TOKEN=seu_token_discord_aqui

# ID do servidor (opcional - para testes em servidor específico)
DISCORD_GUILD_ID=

# Configurações do Cuiudo
CUIUDO_ACTIVITY_INTERVAL=300  # Segundos entre mudanças de atividade (padrão: 5min)
CUIUDO_VERBOSE=false  # true para logs detalhados
